# Copy this file to .env.local for local development.
# Render must define the same two variables at build time.
# VITE_* values are included in the browser bundle, so only use the
# browser-safe Supabase URL and publishable key protected by RLS.
# Never add a secret key, service_role key, Personal Access Token, or SMTP credential.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
